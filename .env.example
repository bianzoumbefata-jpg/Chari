# Modele de configuration des variables d'environnement (Exemple securise)
# ATTENTION : Ne JAMAIS mettre vos vraies cles dans ce fichier ni sur GitHub.
# Vos vraies cles doivent etre placees dans un fichier ".env" local (ignore par Git).

# Fournisseur SMS / OTP (ex: Twilio, Orange, etc.)
OTP_PROVIDER_API_KEY=votre_cle_api_secrete_ici
OTP_SENDER_ID=ChariApp

# Passerelle de paiement (ex: CinetPay, Stripe)
PAYMENT_API_KEY=votre_cle_api_paiement_ici
PAYMENT_SECRET_KEY=votre_cle_secrete_ici
PAYMENT_SITE_ID=votre_id_marchand_ici

# Google Sign-In Client ID (Public web client ID uniquement)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
